{
  "name": "codeflow-website",
  "version": "0.2.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "precommit": "pre-commit run volume-precommit --hook-stage manual",
    "precommit:fast": "PRECOMMIT_DISABLE_PRETTIER=1 pre-commit run volume-precommit --hook-stage manual",
    "precommit:repo": "pwsh -File scripts/.local/precommit.ps1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "15.5.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cspell/dict-en_us": "^4.4.16",
    "@storybook/addon-essentials": "8.6.17",
    "@storybook/addon-interactions": "8.6.17",
    "@storybook/blocks": "8.6.17",
    "@storybook/nextjs": "8.6.17",
    "@storybook/react": "8.6.17",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "jsdom": "^25.0.1",
    "storybook": "8.6.17",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}