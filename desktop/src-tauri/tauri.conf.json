{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeFlow Desktop",
  "version": "0.2.0-alpha.1",
  "identifier": "io.codeflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeFlow Desktop",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "sidecar": {
      "name": "codeflow-sidecar",
      "script": "../sidecar/main.py",
      "python": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}